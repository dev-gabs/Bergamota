<Window x:Class="Bergamota.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bergamota" Width="1280" Height="820" MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#0F1512"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        UseLayoutRounding="True" Icon="/Assets/bergamota.ico"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Animated">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="-1" UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <!-- fundo: gradiente verde escuro + manchas de cor que o vidro "desfoca" -->
        <Grid x:Name="Backdrop" IsHitTestVisible="False">
            <Rectangle x:Name="BaseFill">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#141C18" Offset="0"/>
                        <GradientStop Color="#0F1512" Offset="0.6"/>
                        <GradientStop Color="#18241B" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.95,0" GradientOrigin="0.95,0" RadiusX="0.6" RadiusY="0.8">
                        <GradientStop Color="#4D96B450" Offset="0"/>
                        <GradientStop Color="#0096B450" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.1,0.3" GradientOrigin="0.1,0.3" RadiusX="0.35" RadiusY="0.45">
                        <GradientStop Color="#2EE8923A" Offset="0"/>
                        <GradientStop Color="#00E8923A" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.3,1.05" GradientOrigin="0.3,1.05" RadiusX="0.5" RadiusY="0.6">
                        <GradientStop Color="#40468258" Offset="0"/>
                        <GradientStop Color="#00468258" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.62,0.55" GradientOrigin="0.62,0.55" RadiusX="0.3" RadiusY="0.4">
                        <GradientStop Color="#14C9DC5A" Offset="0"/>
                        <GradientStop Color="#00C9DC5A" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- barra de título -->
            <Grid Background="#14000000">
                <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                    <Image Source="/Assets/bergamota.png" Width="16" Height="16" Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Bergamota" FontSize="12" Foreground="#DDFFFFFF"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource CaptionButton}" Click="Min_Click" ToolTip="Minimizar">
                        <Path Data="M0,0 H10" Stroke="#CCFFFFFF" StrokeThickness="1"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="Max_Click" ToolTip="Maximizar">
                        <Rectangle Width="10" Height="10" Stroke="#CCFFFFFF" StrokeThickness="1"/>
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="Close_Click" ToolTip="Fechar (continua na bandeja)">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="#CCFFFFFF" StrokeThickness="1"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="224"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- barra lateral em vidro -->
                <Border Background="#700C1410" BorderBrush="#12FFFFFF" BorderThickness="0,0,1,0" Padding="16,20">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,2,0,28">
                            <Image Source="/Assets/bergamota.png" Width="30" Height="30" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="bergamota" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom">
                            <Border Height="1" Background="{StaticResource Line}" Margin="4,8,4,12"/>
                            <RadioButton x:Name="NavLog" Style="{StaticResource NavButton}" GroupName="nav" Tag="log" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPath}" Data="{Binding Source=log, Converter={StaticResource Icon}}" Margin="0,0,12,0"/><TextBlock Text="Registros"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavAbout" Style="{StaticResource NavButton}" GroupName="nav" Tag="about" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPath}" Data="{Binding Source=info, Converter={StaticResource Icon}}" Margin="0,0,12,0"/><TextBlock Text="Sobre a Bergamota"/></StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel>
                            <RadioButton x:Name="NavDash" Style="{StaticResource NavButton}" GroupName="nav" Tag="dash" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPath}" Data="{Binding Source=home, Converter={StaticResource Icon}}" Margin="0,0,12,0"/><TextBlock Text="Dashboard"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavEdit" Style="{StaticResource NavButton}" GroupName="nav" Tag="edit" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPath}" Data="{Binding Source=wheel, Converter={StaticResource Icon}}" Margin="0,0,12,0"/><TextBlock Text="Editar Roda"/></StackPanel>
                            </RadioButton>
                            <Button Click="NewProfile_Click" Cursor="Hand" Margin="0,0,0,4">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" CornerRadius="10" Padding="14,10" Background="Transparent">
                                            <StackPanel Orientation="Horizontal">
                                                <Path x:Name="ic" Data="{Binding Source=plus-circle, Converter={StaticResource Icon}}" Stroke="{StaticResource Muted}" StrokeThickness="2"
                                                      Width="17" Height="17" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,12,0"/>
                                                <TextBlock x:Name="tx" Text="Novo Perfil" FontSize="14" FontWeight="Medium" Foreground="{StaticResource Muted}"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#08FFFFFF"/>
                                                <Setter TargetName="tx" Property="Foreground" Value="{StaticResource Text}"/>
                                                <Setter TargetName="ic" Property="Stroke" Value="{StaticResource Text}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Border Height="1" Background="{StaticResource Line}" Margin="4,10,4,12"/>
                            <RadioButton x:Name="NavTrig" Style="{StaticResource NavButton}" GroupName="nav" Tag="trig" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPath}" Data="{Binding Source=gear, Converter={StaticResource Icon}}" Margin="0,0,12,0"/><TextBlock Text="Configurações"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavDevs" Style="{StaticResource NavButton}" GroupName="nav" Tag="devs" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPath}" Data="{Binding Source=wifi, Converter={StaticResource Icon}}" Margin="0,0,12,0"/><TextBlock Text="Dispositivos"/></StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- conteúdo + barra de status -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="48"/>
                    </Grid.RowDefinitions>
                    <ContentControl x:Name="Host" Focusable="False"/>

                    <Border Grid.Row="1" Background="#800A100C" BorderBrush="#12FFFFFF" BorderThickness="0,1,0,0" Padding="20,0">
                        <DockPanel VerticalAlignment="Center" LastChildFill="False">
                            <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{StaticResource Ok}" Margin="0,0,8,0">
                                <Ellipse.Effect><DropShadowEffect Color="#5FD38A" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
                            </Ellipse>
                            <TextBlock DockPanel.Dock="Left" Text="LocalSend" FontSize="12.5" Margin="0,0,10,0"/>
                            <TextBlock DockPanel.Dock="Left" x:Name="NetSummary" FontSize="12.5" Foreground="{StaticResource Muted}"/>
                            <Border DockPanel.Dock="Left" Width="1" Height="20" Background="{StaticResource Line}" Margin="14,0"/>
                            <Border DockPanel.Dock="Left" CornerRadius="8" Background="{StaticResource FieldBg}" BorderBrush="{StaticResource FieldBorder}" BorderThickness="1" Padding="10,5">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{Binding Source=keyboard, Converter={StaticResource Icon}}" Stroke="{StaticResource Muted}" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TrigSummary" FontSize="12" Foreground="{StaticResource Muted}"/>
                                </StackPanel>
                            </Border>
                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Height="32" Padding="14,0" Click="TestWheel_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{Binding Source=eye, Converter={StaticResource Icon}}" Stroke="{StaticResource AccentInk}" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                    <TextBlock Text="Testar a roda" FontSize="12.5"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
