<UserControl x:Class="Bergamota.UI.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Bergamota.Models"
             xmlns:t="clr-namespace:Bergamota.Theme"
             x:Name="Self">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,22,40,28">
            <StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="E D I T A N D O   P E R F I L :" Style="{StaticResource Eyebrow}" HorizontalAlignment="Center"/>
                    <Border CornerRadius="23" Padding="6" Background="#8C0A100C" BorderBrush="{StaticResource GlassStroke}" BorderThickness="1">
                        <ItemsControl x:Name="Pills">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource PillButton}" GroupName="editPills" Content="{Binding Name}" Tag="{Binding}" Checked="Pill_Checked"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <Border x:Name="Card" Style="{StaticResource GlassCard}" MaxWidth="1100" Margin="0,20,0,0">
                    <StackPanel>
                        <!-- cabeçalho do perfil -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="NOME DO PERFIL" Style="{StaticResource Eyebrow}"/>
                                <TextBox Style="{StaticResource Field}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="APARECE QUANDO ARRASTAR" Style="{StaticResource Eyebrow}"/>
                                <TextBox Style="{StaticResource Field}" Text="{Binding Extensions, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="extensões, ex.: .rar .zip · vazio = perfil padrão"/>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,20"/>

                        <TextBlock Style="{StaticResource Eyebrow}">
                            <Run Text="FATIAS DA RODA"/>
                            <Run Text="  ·  use as setas para reordenar · de 2 a 8 fatias · clique no ícone para trocar ícone e cor" Foreground="{StaticResource Dim}" FontWeight="Normal"/>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding Slices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:Slice}">
                                    <Border Style="{StaticResource GlassRow}" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="54"/>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="190"/>
                                                <ColumnDefinition Width="54"/>
                                                <ColumnDefinition Width="44"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Button Style="{StaticResource TinyButton}" Click="Up_Click" ToolTip="Subir">
                                                    <Path Data="{Binding Source=up, Converter={StaticResource Icon}}" Stroke="{StaticResource Dim}" StrokeThickness="2" Width="11" Height="11" Stretch="Uniform"/>
                                                </Button>
                                                <TextBlock Text="{Binding Code}" Foreground="{StaticResource Dim}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                <Button Style="{StaticResource TinyButton}" Click="Down_Click" ToolTip="Descer">
                                                    <Path Data="{Binding Source=down, Converter={StaticResource Icon}}" Stroke="{StaticResource Dim}" StrokeThickness="2" Width="11" Height="11" Stretch="Uniform"/>
                                                </Button>
                                            </StackPanel>

                                            <!-- ícone (abre o seletor) -->
                                            <Button Grid.Column="1" Click="Icon_Click" ToolTip="Trocar ícone" Cursor="Hand" Width="44" Height="44" HorizontalAlignment="Left">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="b" CornerRadius="12" Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                                                            <Path Data="{Binding Icon, Converter={StaticResource Icon}}" Stroke="{Binding SwatchColor, Converter={StaticResource HexBrush}}" StrokeThickness="2"
                                                                  Width="19" Height="19" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <ComboBox Grid.Column="2" Style="{StaticResource Combo}" Margin="0,0,10,0"
                                                      ItemsSource="{Binding KindOptions, ElementName=Self}" DisplayMemberPath="Text" SelectedValuePath="Value"
                                                      SelectedValue="{Binding Kind}"/>

                                            <!-- o que a fatia faz: muda conforme o tipo -->
                                            <Grid Grid.Column="3" Margin="0,0,10,0">
                                                <ComboBox Style="{StaticResource Combo}" Visibility="{Binding Kind, Converter={StaticResource KindVis}, ConverterParameter=Native}"
                                                          ItemsSource="{x:Static m:NativeAction.All}" DisplayMemberPath="Title" SelectedValuePath="Id" SelectedValue="{Binding Action}"/>

                                                <Grid Visibility="{Binding Kind, Converter={StaticResource KindVis}, ConverterParameter=ContextMenu}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBox Style="{StaticResource Field}" Text="{Binding Action}" Tag="texto do item, ex.: Abrir no Terminal"/>
                                                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Margin="8,0,0,0" Click="PickMenu_Click" ToolTip="Escolher a partir do menu de um arquivo">
                                                        <Path Style="{StaticResource IconPath}" Data="{Binding Source=search, Converter={StaticResource Icon}}"/>
                                                    </Button>
                                                </Grid>

                                                <Grid Visibility="{Binding Kind, Converter={StaticResource KindVis}, ConverterParameter=Program}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                                    <Button Style="{StaticResource IconButton}" Margin="0,0,8,0" Click="BrowseProgram_Click" ToolTip="Escolher programa">
                                                        <Path Style="{StaticResource IconPath}" Data="{Binding Source=folder, Converter={StaticResource Icon}}"/>
                                                    </Button>
                                                    <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Action}" Tag="caminho do .exe"/>
                                                    <TextBox Grid.Column="2" Style="{StaticResource Field}" Text="{Binding Args}" Tag="{}{files}" Margin="8,0,0,0" ToolTip="Argumentos. {files} vira a lista de arquivos."/>
                                                </Grid>

                                                <ComboBox Style="{StaticResource Combo}" Visibility="{Binding Kind, Converter={StaticResource KindVis}, ConverterParameter=Send}"
                                                          ItemsSource="{Binding DeviceOptions, ElementName=Self}" DisplayMemberPath="Text" SelectedValuePath="Value" SelectedValue="{Binding Action}"/>
                                            </Grid>

                                            <TextBox Grid.Column="4" Style="{StaticResource Field}" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Tag="rótulo na roda"/>

                                            <Button Grid.Column="5" Style="{StaticResource PlayButton}" Click="Test_Click" ToolTip="Testar com arquivos que você escolher" HorizontalAlignment="Right">
                                                <Path Data="{Binding Source=play, Converter={StaticResource Icon}}" Stroke="{StaticResource Ok}" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" StrokeLineJoin="Round"/>
                                            </Button>
                                            <Button Grid.Column="6" Style="{StaticResource IconButton}" Click="Remove_Click" ToolTip="Remover fatia" HorizontalAlignment="Right">
                                                <Path Style="{StaticResource IconPath}" Data="{Binding Source=trash, Converter={StaticResource Icon}}" Width="15" Height="15"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="AddSlice_Click" Margin="0,2,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPath}" Data="{Binding Source=plus, Converter={StaticResource Icon}}" Width="14" Height="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Adicionar fatia"/>
                            </StackPanel>
                        </Button>

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource DangerButton}" Click="Delete_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconPath}" Data="{Binding Source=trash, Converter={StaticResource Icon}}" Width="15" Height="15" Margin="0,0,8,0"/>
                                    <TextBlock Text="Excluir perfil"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Height="50" Click="Preview_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconPath}" Data="{Binding Source=eye, Converter={StaticResource Icon}}" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Pré-visualizar"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Click="Save_Click">
                                <TextBlock x:Name="SaveText" Text="SALVAR ALTERAÇÕES" FontSize="14"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- seletor de ícones (um só, reaproveitado por todas as fatias) -->
        <Popup x:Name="IconPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade" VerticalOffset="6">
            <Border Background="#F5141C17" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="16" Padding="12" Width="372">
                <StackPanel>
                    <TextBlock Text="COR DA FATIA" Style="{StaticResource Eyebrow}"/>
                    <ItemsControl x:Name="ColorGrid" Margin="0,0,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="PickColor_Click" Tag="{Binding Hex}" Cursor="Hand" Margin="0,0,4,4" ToolTip="{Binding Name}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Width="34" Height="34" CornerRadius="10" Padding="4" Background="#0AFFFFFF"
                                                    BorderBrush="#12FFFFFF" BorderThickness="2">
                                                <Grid>
                                                    <Border CornerRadius="6" Background="{Binding Hex, Converter={StaticResource HexBrush}}"/>
                                                    <TextBlock Text="A" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentInk}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding IsAuto, Converter={StaticResource Vis}}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Selected}" Value="True">
                                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Text}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="BorderBrush" Value="#80FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="ÍCONE" Style="{StaticResource Eyebrow}"/>
                    <ItemsControl x:Name="IconGrid">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="PickIcon_Click" Tag="{Binding}" Cursor="Hand" Margin="0,0,4,4" ToolTip="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Width="40" Height="40" CornerRadius="10" Background="#0AFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1">
                                                <Path x:Name="p" Data="{Binding Converter={StaticResource Icon}}" Stroke="#CFDCD2" StrokeThickness="2" Width="18" Height="18"
                                                      Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource AccentSoft}"/>
                                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                    <Setter TargetName="p" Property="Stroke" Value="{StaticResource Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
