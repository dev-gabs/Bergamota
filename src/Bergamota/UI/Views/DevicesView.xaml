<UserControl x:Class="Bergamota.UI.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,26,40,28">
        <StackPanel MaxWidth="1100">
            <Grid Margin="0,0,0,20">
                <TextBlock Text="N A   M E S M A   R E D E   ·   V I A   L O C A L S E N D" Style="{StaticResource Eyebrow}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border HorizontalAlignment="Right" BorderBrush="{StaticResource Muted}" BorderThickness="0,0,2,0" Padding="0,0,16,0">
                    <TextBlock Text="D I S P O S I T I V O S" Style="{StaticResource PageTitle}"/>
                </Border>
            </Grid>

            <!-- busca -->
            <Border Style="{StaticResource GlassCard}" Padding="20,16">
                <DockPanel>
                    <Button x:Name="ScanBtn" DockPanel.Dock="Left" Style="{StaticResource AccentButton}" Click="Scan_Click" Padding="18,0">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="ScanIcon" Data="{Binding Source=refresh, Converter={StaticResource Icon}}" Stroke="{StaticResource AccentInk}" StrokeThickness="2.2"
                                  Width="16" Height="16" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform><RotateTransform x:Name="Spin"/></Path.RenderTransform>
                            </Path>
                            <TextBlock x:Name="ScanText" Text="Buscar agora"/>
                        </StackPanel>
                    </Button>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Busca automática" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,12,0"/>
                        <ComboBox x:Name="IntervalCombo" Style="{StaticResource Combo}" Width="150" SelectionChanged="Interval_Changed"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="18,0">
                        <TextBlock x:Name="ScheduleText" Text="{Binding ScheduleText}" FontWeight="Medium"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Escuta anúncios da rede sem gastar CPU. O botão faz uma varredura completa; a automática é leve e só confirma quem já é conhecido."/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- aparelhos -->
            <ItemsControl x:Name="DeviceList" Margin="0,18,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource GlassCard}" Margin="0,0,16,16" Padding="22">
                            <Grid>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="11" Padding="10,3" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1A5FD38A"/>
                                            <Setter Property="BorderBrush" Value="#4D5FD38A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                    <Setter Property="Background" Value="#0DFFFFFF"/>
                                                    <Setter Property="BorderBrush" Value="#26FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding LastSeenText}" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Ok}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <StackPanel>
                                    <Path Data="{Binding IconName, Converter={StaticResource Icon}}" Stroke="#CFDCD2" StrokeThickness="1" Width="64" Height="64"
                                          Stretch="Uniform" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,18,0,16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Alias}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding Address}" Style="{StaticResource Hint}"/>
                                    <Border Height="1" Background="{StaticResource Line}" Margin="0,14,0,12"/>
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowInWheel}"/>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource TinyButton}" Width="60" Margin="0,0,10,0" Click="Forget_Click" ToolTip="Remover da lista">
                                            <TextBlock Text="esquecer" FontSize="11.5" Foreground="{StaticResource Dim}"/>
                                        </Button>
                                        <TextBlock Text="Mostrar na roda" VerticalAlignment="Center" FontSize="13"/>
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="EmptyHint" Style="{StaticResource GlassCard}" Padding="22" BorderBrush="#4D33463B">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Nenhum aparelho ainda" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="520"
                               Text="Instale o LocalSend no celular (Play Store), abra o app com o celular no mesmo Wi-Fi e clique em Buscar agora."/>
                </StackPanel>
            </Border>

            <!-- este PC + recebimento -->
            <Border Style="{StaticResource GlassCard}" Margin="0,4,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{Binding Source=download, Converter={StaticResource Icon}}" Stroke="{StaticResource Accent}" StrokeThickness="2" Width="20" Height="20" Stretch="Uniform" Margin="0,0,12,0"/>
                        <TextBlock Text="Este PC e recebimento" Style="{StaticResource CardTitle}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,16"
                               Text="Por enquanto a Bergamota só envia. Para receber do celular no PC, use o LocalSend para Windows (os dois convivem). Numa próxima versão a própria Bergamota recebe."/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="NOME DESTE PC NA REDE" Style="{StaticResource Eyebrow}"/>
                            <TextBox x:Name="AliasBox" Style="{StaticResource Field}" LostFocus="Alias_LostFocus"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="QUEM RECEBE NO PC" Style="{StaticResource Eyebrow}"/>
                            <Border Height="44" CornerRadius="10" Background="{StaticResource FieldBg}" BorderBrush="{StaticResource FieldBorder}" BorderThickness="1" Padding="14,0">
                                <TextBlock x:Name="ReceiverText" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
