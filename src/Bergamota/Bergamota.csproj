<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms só para o ícone da bandeja (NotifyIcon) e captura de tela (System.Drawing) -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\bergamota.ico</ApplicationIcon>
    <AssemblyName>Bergamota</AssemblyName>
    <RootNamespace>Bergamota</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Bergamota</Product>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- o DPI por monitor vem do app.manifest (necessário no WPF); o aviso é do analisador do WinForms -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- evita conflito de nomes entre WPF e WinForms (Application, Button, Color...) -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\bergamota.ico" />
    <Resource Include="Assets\bergamota.png" />
  </ItemGroup>

</Project>
