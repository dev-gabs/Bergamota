<Application x:Class="Bergamota.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:Bergamota.Theme"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <t:IconConverter x:Key="Icon"/>
            <t:BoolToVisibility x:Key="Vis"/>
            <t:BoolToVisibility x:Key="NotVis" Invert="True"/>
            <t:KindToVisibility x:Key="KindVis"/>
            <t:HexToBrush x:Key="HexBrush"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
